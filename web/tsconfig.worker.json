{
  // src/sw.ts runs in a service-worker context, not the DOM — type-check it against the WebWorker
  // lib (where `ServiceWorkerGlobalScope`, `PushEvent`, `clients`, etc. live) instead of DOM, which
  // the app tsconfig uses. src/stt/worker.ts, the speech worker (ADR 0096), is a dedicated worker
  // and needs the same lib for `importScripts` and `DedicatedWorkerGlobalScope`. `bun run typecheck` runs both. Mixing the two libs in one project would
  // produce conflicting global declarations, so the SW gets its own pass.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "WebWorker"],
    "types": []
  },
  "include": ["src/sw.ts", "src/stt/worker.ts", "src/build-info.d.ts"],
  "exclude": []
}
