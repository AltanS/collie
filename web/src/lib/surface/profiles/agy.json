{
  "id": "agy",
  "identity": {
    "binary": "agy",
    "versionCommand": [
      "agy",
      "--version"
    ],
    "versionRegex": "\\d+\\.\\d+\\.\\d+",
    "agentNames": [
      "antigravity"
    ]
  },
  "versions": [
    {
      "range": "1.1.0 - 1.4.8",
      "status": "provisional",
      "verifiedThrough": null,
      "verifiedOn": null
    }
  ],
  "idle": {
    "frame": {
      "top": {
        "pattern": "^─+$",
        "minCells": 8,
        "column": 0
      },
      "prompt": {
        "pattern": "^>(?: (?<draft>.*))?$",
        "column": 0
      },
      "bottom": {
        "pattern": "^─+$",
        "minCells": 8,
        "column": 0
      },
      "continuationIndent": 2,
      "maxDraftRows": 60,
      "maxTailRows": 8
    },
    "placeholders": {
      "texts": [
        "Ask anything or type / for commands",
        "Auto mode: edits & safe commands auto-approved (shift+tab to cycle)"
      ],
      "prefixes": [
        "Auto mode: edits & safe commands auto-approved"
      ],
      "sgr": 2
    },
    "volatile": {
      "above": {
        "maxRows": 6
      },
      "below": {
        "maxRows": 8,
        "footerMaxRows": 16,
        "footerRows": [
          {
            "name": "background-task",
            "pattern": "^ {2}● \\[\\d{2}:\\d{2}:\\d{2}\\] .+ running$"
          }
        ],
        "commandList": {
          "sides": [
            "under"
          ],
          "pointer": "^> (?<command>/\\S+)(?: +\\S.*)?$",
          "entry": "^ {2}(?<command>/\\S+)(?: +\\S.*)?$",
          "wrapped": "^ {4,}\\S",
          "footer": {
            "pattern": "^\\s*↑/↓ Navigate · enter Select · tab Complete\\s*$",
            "maxRows": 2
          }
        }
      }
    },
    "runningRows": [
      "^esc to cancel\\b",
      "^[⠀-⣿]\\s+\\S.*\\.\\.\\.\\s*$"
    ]
  },
  "keys": {
    "submit": [
      "Enter"
    ],
    "newline": [
      "ctrl+j"
    ],
    "interrupt": [
      "Escape"
    ],
    "clear": {
      "key": "Backspace",
      "slack": 16
    },
    "navigation": {
      "up": "Up",
      "down": "Down",
      "confirm": "Enter",
      "cancel": "Escape"
    }
  },
  "collapse": {
    "pattern": "\\[Pasted [^\\]]*\\]"
  },
  "reservedLeads": [
    "/",
    "!",
    "@"
  ],
  "probe": {
    "char": "⌁",
    "status": "provisional",
    "note": "No live probed send has passed in Collie's own lab: agy is not installed on bluefin, LAB.md has no row for it, and the M56 spec 01 lab did not run it. A contributor's local macOS verification on 1.4.4 to 1.4.8 (PR 619) covers boxed composers, gray Auto hints, normal sends and native panels (/model, /effort, /resume, /artifact, /usage, /context); the saved screens are in web/src/fixtures/panes (agy--*.txt, 1.1.17 to 1.3.5) and web/src/lib/harness/agy/fixtures (1.4.4 to 1.4.8). Provisional until a live probed send passes; fallback ¤"
  },
  "paste": {
    "bracketed": true
  },
  "hooks": {}
}
