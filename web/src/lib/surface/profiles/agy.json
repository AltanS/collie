{
  "id": "agy",
  "identity": {
    "binary": "agy",
    "versionCommand": [
      "agy",
      "--version"
    ],
    "versionRegex": "\\d+\\.\\d+\\.\\d+",
    "agentNames": [
      "antigravity"
    ]
  },
  "versions": [
    {
      "range": "1.1.0 - 1.1.17",
      "status": "provisional",
      "verifiedThrough": null,
      "verifiedOn": null
    }
  ],
  "idle": {
    "frame": {
      "top": {
        "pattern": "^─+$",
        "minCells": 8,
        "column": 0
      },
      "prompt": {
        "pattern": "^>(?: (?<draft>.*))?$",
        "column": 0
      },
      "bottom": {
        "pattern": "^─+$",
        "minCells": 8,
        "column": 0
      },
      "continuationIndent": 2,
      "maxDraftRows": 60,
      "maxTailRows": 8
    },
    "placeholders": {
      "texts": [],
      "sgr": 2
    },
    "volatile": {
      "above": {
        "maxRows": 6
      },
      "below": {
        "maxRows": 2,
        "footerMaxRows": 2
      }
    },
    "runningRows": [
      "^esc to cancel\\b",
      "^[⠀-⣿]\\s+\\S.*\\.\\.\\.\\s*$"
    ]
  },
  "keys": {
    "submit": [
      "Enter"
    ],
    "newline": [
      "ctrl+j"
    ],
    "interrupt": [
      "Escape"
    ],
    "clear": {
      "key": "Backspace",
      "slack": 16
    },
    "navigation": {
      "up": "Up",
      "down": "Down",
      "confirm": "Enter",
      "cancel": "Escape"
    }
  },
  "collapse": {
    "pattern": "\\[Pasted [^\\]]*\\]"
  },
  "reservedLeads": [
    "/",
    "!",
    "@"
  ],
  "probe": {
    "char": "⌁",
    "status": "provisional",
    "note": "No live send has passed on this harness: it is not installed on bluefin, LAB.md has no row for it, and the M56 spec 01 lab did not run it. The box layout comes from the saved screens in web/src/fixtures/panes (agy--*.txt, Antigravity CLI 1.1.17 to 1.3.5). Provisional until a live probed send passes; fallback ¤"
  },
  "paste": {
    "bracketed": true
  },
  "hooks": {}
}
