{
  "id": "muse",
  "identity": {
    "binary": "muse",
    "versionCommand": [
      "muse",
      "--version"
    ],
    "versionRegex": "\\d+\\.\\d+\\.\\d+"
  },
  "versions": [
    {
      "range": "1.3.0 - 1.4.7",
      "status": "verified",
      "verifiedThrough": "1.4.7",
      "verifiedOn": "2026-10-12"
    }
  ],
  "idle": {
    "frame": {
      "top": {
        "pattern": "^─+(?:\\s+(?<label>\\S.*?)\\s+─+)?$",
        "minCells": 8,
        "column": 0
      },
      "prompt": {
        "pattern": "^❯(?: (?<draft>.*))?$",
        "column": 0
      },
      "bottom": {
        "pattern": "^─+$",
        "minCells": 8,
        "column": 0
      },
      "continuationIndent": 2,
      "maxDraftRows": 60,
      "maxTailRows": 3
    },
    "placeholders": {
      "texts": [
        "Start a message with ! to run a shell command yourself",
        "/loop 10m <prompt> schedules a recurring prompt",
        "Paste an image with Ctrl+V — file paths and URLs work too"
      ],
      "sgr": 2,
      "fg": [
        "rgb(175,177,179)"
      ]
    },
    "volatile": {
      "above": {
        "maxRows": 6
      },
      "below": {
        "maxRows": 2,
        "footerMaxRows": 2,
        "commandList": {
          "pointer": "^  (?<command>/\\S+)(?: · [^·]+?)* {2,}\\S.*$",
          "entry": "^  (?<command>/\\S+)(?: · [^·]+?)* {2,}\\S.*$",
          "wrapped": "^  ↓ \\d+ more$",
          "sides": [
            "inside"
          ],
          "pointerBold": true,
          "argumentHint": true
        }
      }
    },
    "dialogsInBox": true,
    "runningRows": [
      "^[◆◇◈⠀-⣿]\\s.*\\(\\d+[hms][^)]*·\\s+esc to interrupt\\)"
    ]
  },
  "keys": {
    "submit": [
      "Enter"
    ],
    "newline": [
      "ctrl+j"
    ],
    "interrupt": [
      "Escape"
    ],
    "interruptClearsDraft": true,
    "clear": {
      "key": "Backspace",
      "slack": 16
    },
    "navigation": {
      "up": "Up",
      "down": "Down",
      "confirm": "Enter",
      "cancel": "Escape"
    },
    "enterWhileRunning": "steers",
    "neverHeld": [
      "/clear",
      "/new",
      "/exit",
      "/quit",
      "/logout",
      "/resume",
      "/fork",
      "/rewind",
      "!"
    ],
    "queueKey": "Tab",
    "queuedRow": {
      "pattern": "^\\s*└ (?<text>\\S.*?)\\s*$",
      "hint": "^\\s*◆ Queued input · ↑ to edit\\s*$",
      "hintGap": 0,
      "hintAbove": true
    }
  },
  "collapse": {
    "pattern": "\\[(?:Pasted Content \\d+ chars|Image #\\d+)\\]"
  },
  "reservedLeads": [
    "/",
    "!",
    "@"
  ],
  "probe": {
    "char": "⌁",
    "status": "provisional",
    "note": "No live send has passed on this harness: it is not installed on bluefin, LAB.md has no row for it, and the M56 spec 01 lab did not run it. The box layout comes from the saved screens in web/src/fixtures/panes (muse--*.txt, Muse Code 1.3.0 to 1.4.8; muse is also absent from the harness table of LAB.md). Provisional until a live probed send passes; fallback ¤"
  },
  "paste": {
    "bracketed": true,
    "settleMs": 350
  },
  "hooks": {}
}
