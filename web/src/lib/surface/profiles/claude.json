{
  "id": "claude",
  "identity": {
    "binary": "claude",
    "versionCommand": ["claude", "--version"],
    "versionRegex": "\\d+\\.\\d+\\.\\d+"
  },
  "versions": [
    {
      "range": "2.1.0 - 2.1.302",
      "status": "verified",
      "verifiedThrough": "2.1.302",
      "verifiedOn": "2026-10-17"
    }
  ],
  "idle": {
    "frame": {
      "top": { "pattern": "^─+(?:\\s+(?<label>.*[^\\s─-╿▁-▔‒-―].*?)\\s+─+)?$", "minCells": 8, "column": 0 },
      "prompt": { "pattern": "^(?:❯|!(?=\\s|$))(?:\\s?(?<draft>.+))?$", "column": 0 },
      "bottom": { "pattern": "^─+$", "minCells": 8, "column": 0 },
      "continuationIndent": 2,
      "maxDraftRows": 100,
      "maxTailRows": 60
    },
    "placeholders": {
      "texts": ["Press up to edit queued messages"],
      "sgr": 2
    },
    "volatile": {
      "above": { "maxRows": 6 },
      "below": {
        "maxRows": 8,
        "footerMaxRows": 8,
        "footerRows": [
          { "name": "agents-panel-main", "pattern": "^\\s*(?:❯\\s+)?●\\s+main(?:\\s.*)?$" },
          { "name": "agents-panel-agent", "pattern": "^\\s*(?:❯\\s+)?◯\\s+\\S.*$" },
          { "name": "agents-panel-more", "pattern": "^\\s*↓ \\d+ more$" },
          { "name": "agents-panel-manage-hint", "pattern": "^\\s*↓ to manage$" },
          { "name": "tasks-view-hint", "pattern": "^\\s*(?:⏵⏵|⏸|\\?)\\s.*\\s·\\s↓ to view(?:\\s·\\s|$)" }
        ],
        "otherScreens": [
          { "name": "agents screen", "pattern": "^\\s*enter to return(?:\\s·\\s|$)" }
        ],
        "commandList": {
          "pointer": "^ {1,4}❯ (?<command>[/…]\\S+)(?: +\\S.*)?$",
          "entry": "^ {2,6}(?<command>[/…]\\S+)(?: +\\S.*)?$",
          "wrapped": "^ {8,}\\S"
        }
      }
    },
    "notices": [
      { "head": "^✦ (?:Heads up|You should know) ·(?:\\s|$)", "body": true },
      { "head": "^● How is Claude doing this session\\? \\(optional\\)$" },
      { "head": "^● Can Anthropic look at your session transcript to help us improve Claude Code\\?$", "letters": true },
      { "head": "^✦ Dismissed\\.(?=\\s|$)" }
    ],
    "noticeGaps": [
      "^ +You've used \\d{1,3}% of your [\\w -]+ limit(?: ·|$)",
      "^ *✔ Update installed · Restart to (?:update|apply)$"
    ]
  },
  "keys": {
    "submit": ["Enter"],
    "newline": ["ctrl+j"],
    "interrupt": ["Escape"],
    "clear": { "key": "Backspace", "slack": 16 },
    "navigation": {
      "up": "Up",
      "down": "Down",
      "confirm": "Enter",
      "cancel": "Escape"
    },
    "enterWhileRunning": "queues",
    "commandWhileRunning": "queues",
    "commandWhileRunningNote": "Lab 2026-10-16: measured on Claude Code 2.1.301 with /help only (queued as a row above the box, ran after the turn).",
    "neverHeld": ["/clear", "/exit", "/quit", "/logout", "/resume", "/branch", "!"],
    "queuedRow": {
      "pattern": "^\\s*❯ (?<text>\\S.*?)\\s*$",
      "hint": "^\\s*(?:ctrl\\+enter|ctrl\\+x ctrl\\+s) to send now\\s*$",
      "hintGap": 1
    }
  },
  "collapse": {
    "pattern": "\\[Pasted text #(?<n>\\d+)(?: \\+(?<lines>\\d+) lines)?\\]"
  },
  "reservedLeads": ["/", "!", "@"],
  "probe": {
    "char": "⌁",
    "status": "verified",
    "note": "M56 spec 01 lab, 2026-10-15: inert after the type and after Backspace in every dialog without a text field, on Herdr, tmux and zellij; fallback ¤"
  },
  "paste": {
    "bracketed": true
  },
  "ask": {
    "lifetimeMs": 5000
  },
  "hooks": {
    "SessionStart": "edge",
    "UserPromptSubmit": "edge",
    "Stop": "edge",
    "SessionEnd": "edge",
    "Notification": "edge",
    "PermissionRequest": "ask",
    "PostToolUse": "edge"
  },
  "edges": {
    "rereadMs": 700,
    "settleMs": 1500,
    "events": {
      "SessionStart": "start",
      "UserPromptSubmit": "prompt",
      "Stop": "stop",
      "SessionEnd": "end",
      "Notification:permission_prompt": "dialog",
      "Notification:elicitation_dialog": "dialog",
      "Notification:idle_prompt": "reread",
      "PostToolUse": "tool"
    }
  },
  "hold": {
    "event": "PermissionRequest",
    "toolEvent": "PostToolUse",
    "limitMs": 290000,
    "hookTimeoutS": 300,
    "minVersion": "2.0.45",
    "inputShown": ["command", "file_path", "notebook_path", "url", "pattern", "path", "query"],
    "inputDetails": {
      "Bash": { "flags": ["dangerouslyDisableSandbox", "run_in_background"] },
      "Write": { "body": ["content"] },
      "Edit": { "body": ["new_string"] },
      "NotebookEdit": { "body": ["new_source"] }
    },
    "screenOnly": ["AskUserQuestion", "ExitPlanMode"],
    "headers": {
      "Bash": ["Bash command", "Bash"],
      "Write": ["Create file"],
      "Edit": ["Edit file"],
      "WebFetch": ["Fetch"]
    },
    "agentMark": "·\\s*from the\\s*(.*?)(?:\\s+agent)?\\s*$",
    "options": [
      { "label": "Yes", "decision": "allow" },
      { "label": "No", "decision": "deny" }
    ],
    "decisions": [
      { "match": "^Yes$", "decision": "allow" },
      { "match": "^No(?:\\b|$)", "decision": "deny" }
    ],
    "decidedLine": "Allowed by PermissionRequest hook",
    "deniedLine": "(?:Denied by PermissionRequest hook|Interrupted · What should Claude do instead\\?)",
    "denyMessage": "The person denied this from Collie."
  }
}
