{
  "id": "opencode",
  "identity": {
    "binary": "opencode",
    "versionCommand": [
      "opencode",
      "--version"
    ],
    "versionRegex": "\\d+\\.\\d+\\.\\d+"
  },
  "versions": [
    {
      "range": "1.18.0 - 1.19.5",
      "status": "verified",
      "verifiedThrough": "1.19.5",
      "verifiedOn": "2026-10-29"
    }
  ],
  "idle": {
    "frame": {
      "walk": "interior",
      "top": {
        "pattern": "^ *┃$",
        "column": 2,
        "maxColumn": 200
      },
      "prompt": {
        "pattern": "^ *┃(?: {2}(?<draft>.*))?$",
        "column": 2,
        "maxColumn": 200
      },
      "bottom": {
        "pattern": "^ *╹▀+$",
        "column": 2,
        "maxColumn": 200
      },
      "rows": "^ *┃(?: .*)?$",
      "trailer": {
        "row": "^ *┃ {2}\\S[^·]*·\\s?\\S.*$",
        "pad": "^ *┃$",
        "maxPad": 2
      },
      "continuation": "^ *┃(?: {2}(?<text>.*))?$",
      "continuationIndent": 2,
      "maxDraftRows": 100,
      "maxTailRows": 60
    },
    "placeholders": {
      "texts": [],
      "prefixes": [
        "Ask anything…"
      ],
      "sgr": 0
    },
    "volatile": {
      "above": {
        "maxRows": 6
      },
      "below": {
        "maxRows": 3,
        "footerMaxRows": 2
      }
    },
    "runningRows": [
      "^\\s*[⬝⬞■▪□▫]*\\s*esc interrupt\\b"
    ],
    "overlayRows": [
      "^[\\s┃]*\\S(?:.*\\S)?\\s{3,}esc\\s*$"
    ]
  },
  "keys": {
    "submit": [
      "Enter"
    ],
    "newline": [
      "ctrl+j"
    ],
    "interrupt": [
      "Escape",
      "Escape"
    ],
    "clear": {
      "key": "Backspace",
      "slack": 16
    },
    "navigation": {
      "up": "Up",
      "down": "Down",
      "confirm": "Enter",
      "cancel": "Escape"
    },
    "enterWhileRunning": "queues"
  },
  "collapse": {
    "pattern": "\\[Pasted ~(?<lines>\\d+) lines\\]"
  },
  "reservedLeads": [
    "/",
    "!",
    "@"
  ],
  "probe": {
    "char": "⌁",
    "status": "provisional",
    "note": "M56 spec 01 lab, 2026-10-15, opencode 1.18.35: inert after the type and after Backspace in the permission and question dialogs on Herdr, tmux and zellij; the box shows it as `┃  ⌁`; fallback ¤; live sends passed on opencode 1.19.2 only, above the ledger range 1.18.0 to 1.18.33, so the probe stays on until a send passes inside it"
  },
  "paste": {
    "bracketed": true
  },
  "hooks": {}
}
