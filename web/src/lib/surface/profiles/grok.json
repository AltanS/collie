{
  "id": "grok",
  "identity": {
    "binary": "grok",
    "versionCommand": [
      "grok",
      "--version"
    ],
    "versionRegex": "\\d+\\.\\d+\\.\\d+"
  },
  "versions": [
    {
      "range": "1.0.0 - 1.0.77",
      "status": "verified",
      "verifiedThrough": "1.0.77",
      "verifiedOn": "2026-11-16"
    }
  ],
  "idle": {
    "frame": {
      "walk": "interior",
      "top": {
        "pattern": "^ *╭─+╮?$",
        "column": 2,
        "maxColumn": 3
      },
      "prompt": {
        "pattern": "^ *│ ❯(?: (?<draft>.*?))?\\s*(?:[█▌▐]\\s*)?│?$",
        "column": 2,
        "maxColumn": 3
      },
      "bottom": {
        "pattern": "^ *╰─.*$",
        "column": 2,
        "maxColumn": 3
      },
      "rows": "^ *(?:╭─.*|│.*)$",
      "continuation": "^ *│ {1,3}(?<text>.*?)\\s*(?:[█▌▐]\\s*)?│?$",
      "continuationIndent": 0,
      "maxDraftRows": 60,
      "maxTailRows": 4,
      "ownPrompt": true
    },
    "placeholders": {
      "texts": [],
      "sgr": 2
    },
    "volatile": {
      "above": {
        "maxRows": 6
      },
      "below": {
        "maxRows": 3,
        "footerMaxRows": 2
      }
    },
    "runningRows": [
      "^\\s*(?:[^\\s│❯][^│❯]*│\\s*)*(?:Esc|Ctrl\\+c):cancel\\b",
      "^\\s*[⠁-⣿]\\s+\\S[^…]*…\\s+\\d+(?:\\.\\d+)?s\\b"
    ],
    "dialogsInBox": true,
    "overlayRows": [
      "\\s•\\s\\d+ tokens\\s*$"
    ],
    "inlineHint": {
      "fg": [
        "rgb(108,108,108)"
      ]
    }
  },
  "keys": {
    "submit": [
      "Enter"
    ],
    "newline": [
      "ctrl+j"
    ],
    "interrupt": [
      "ctrl+c"
    ],
    "interruptClearsDraft": true,
    "clear": {
      "key": "Backspace",
      "slack": 16
    },
    "navigation": {
      "up": "Up",
      "down": "Down",
      "confirm": "Enter",
      "cancel": "Escape"
    },
    "enterWhileRunning": "queues",
    "queuedRow": {
      "pattern": "^\\s*#\\d+ (?<text>\\S.*?)\\s*$",
      "hint": "^\\s*▾ Queued \\d+\\s*$",
      "hintGap": 0,
      "hintAbove": true
    }
  },
  "collapse": {
    "pattern": "\\[Pasted[ :][^\\]]*\\]"
  },
  "reservedLeads": [
    "/",
    "!",
    "@"
  ],
  "probe": {
    "char": "⌁",
    "status": "provisional",
    "note": "Harness lab 2026-11-16 on Grok Build 1.0.77 over a scratch Herdr: three live probed sends passed, two on an idle box (sent) and one into a running turn (sent, queued); the probe showed once in the box and Backspace took it out. Its inertness in Grok's dialogs (trust, permission, ask, plan) is not measured, so the status stays provisional and every send stays probed. The box layout comes from the saved screens in web/src/fixtures/panes (grok--*.txt, Grok Build 1.0.46 to 1.0.77); fallback ¤"
  },
  "paste": {
    "bracketed": true
  },
  "hooks": {}
}
