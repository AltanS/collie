{
  "id": "omp",
  "identity": {
    "binary": "omp",
    "versionCommand": [
      "omp",
      "--version"
    ],
    "versionRegex": "\\d+\\.\\d+\\.\\d+"
  },
  "versions": [
    {
      "range": "18.4.0 - 18.4.10",
      "status": "verified",
      "verifiedThrough": "18.4.10",
      "verifiedOn": "2026-10-02"
    }
  ],
  "idle": {
    "frame": {
      "walk": "interior",
      "top": {
        "pattern": "^(?:╭─{2}.*|\\s?(?:π|[⠀-⣿]\\s+\\d+s)\\s.*▶─.*)$",
        "column": 0,
        "maxColumn": 1
      },
      "prompt": {
        "pattern": "^(?:╰─|│) {0,2}(?<draft>(?:(?!\\s{8,}\\S).)*)(?:\\s{8,}\\S.*)?$",
        "column": 0
      },
      "bottom": {
        "pattern": "^",
        "column": 0,
        "maxColumn": 3,
        "open": true
      },
      "rows": "^(?:\\s?(?:π|[⠀-⣿]\\s+\\d+s)\\s.*▶.*|╭─.*|╰─.*|│.*|\\s{3}.*|\\s*)$",
      "continuation": "^(?:│|╰─)? ?(?<text>.*)$",
      "continuationIndent": 0,
      "maxDraftRows": 40,
      "maxTailRows": 3
    },
    "frameAlternates": [
      {
        "top": {
          "pattern": "^─+(?:\\s+(?<label>\\S.*?))?(?:\\s+─+)?$",
          "minCells": 8,
          "column": 0
        },
        "prompt": {
          "pattern": "^❯(?: (?<draft>(?:(?!\\s{8,}\\S).)*))?(?:\\s{8,}\\S.*)?$",
          "column": 0
        },
        "bottom": {
          "pattern": "^─+$",
          "minCells": 8,
          "column": 0
        },
        "continuationIndent": 2,
        "maxDraftRows": 40,
        "maxTailRows": 3
      },
      {
        "walk": "interior",
        "top": {
          "pattern": "^─+$",
          "minCells": 8,
          "column": 0
        },
        "prompt": {
          "pattern": "^(?<draft>(?:(?!\\s{8,}\\S).)*)(?:\\s{8,}\\S.*)?$",
          "column": 0,
          "maxColumn": 400
        },
        "bottom": {
          "pattern": "^─+$",
          "minCells": 8,
          "column": 0
        },
        "under": "^\\s*\\S.*·",
        "continuationIndent": 0,
        "maxDraftRows": 30,
        "maxTailRows": 3
      },
      {
        "walk": "interior",
        "top": {
          "pattern": "^─+(?:\\s+\\S.*)?$",
          "minCells": 8,
          "column": 0
        },
        "prompt": {
          "pattern": "^❯(?: (?<draft>(?:(?!\\s{8,}\\S).)*))?(?:\\s{8,}\\S.*)?$",
          "column": 0
        },
        "bottom": {
          "pattern": "^",
          "column": 0,
          "maxColumn": 3,
          "open": true
        },
        "rows": "^(?:─+.*|❯.*|\\s{2}.*|\\s*|\\s*\\S.*·.*)$",
        "trailer": {
          "row": "^\\s*\\S.*·.*$"
        },
        "continuation": "^\\s{0,2}(?<text>.*)$",
        "continuationIndent": 0,
        "maxDraftRows": 40,
        "maxTailRows": 3
      },
      {
        "top": {
          "pattern": "^$",
          "column": 0,
          "blank": true
        },
        "prompt": {
          "pattern": "^❯(?: (?<draft>(?:(?!\\s{8,}\\S).)*))?(?:\\s{8,}\\S.*)?$",
          "column": 0
        },
        "bottom": {
          "pattern": "^\\s?π · .*$",
          "column": 0,
          "maxColumn": 1
        },
        "continuationIndent": 2,
        "maxDraftRows": 40,
        "maxTailRows": 3
      }
    ],
    "placeholders": {
      "texts": [],
      "sgr": 2
    },
    "volatile": {
      "above": {
        "maxRows": 6
      },
      "below": {
        "maxRows": 2,
        "footerMaxRows": 2
      }
    },
    "runningRows": [
      "^\\s*[⠀-⣿] Working…",
      "^\\s*⎋ Working…",
      "^\\s?[⠀-⣿]\\s+\\d+s\\s.*▶"
    ],
    "dialogsInBox": true
  },
  "keys": {
    "submit": [
      "Enter"
    ],
    "newline": [
      "ctrl+j"
    ],
    "interrupt": [
      "Escape"
    ],
    "clear": {
      "key": "Backspace",
      "slack": 16
    },
    "navigation": {
      "up": "Up",
      "down": "Down",
      "confirm": "Enter",
      "cancel": "Escape"
    },
    "enterWhileRunning": "steers",
    "queueKey": "ctrl+q",
    "queuedRow": {
      "pattern": "^\\s*\\d+\\. (?<text>\\S.*?)\\s*$",
      "hint": "^\\s*└ Alt\\+↑ to edit\\s*$",
      "hintGap": 0
    }
  },
  "collapse": {
    "pattern": "📄 #\\d+"
  },
  "reservedLeads": [
    "/",
    "!",
    "@"
  ],
  "probe": {
    "char": "⌁",
    "status": "verified",
    "note": "M56 spec 01 lab, 2026-10-15, omp: inert in every dialog without a text field on Herdr, tmux and zellij; the box shows it as `╰─ ⌁`; the /model picker takes Backspace, so a probe there fails safe; fallback ¤"
  },
  "paste": {
    "bracketed": true
  },
  "hooks": {}
}
