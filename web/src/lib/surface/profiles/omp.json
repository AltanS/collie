{
  "id": "omp",
  "identity": {
    "binary": "omp",
    "versionCommand": [
      "omp",
      "--version"
    ],
    "versionRegex": "\\d+\\.\\d+\\.\\d+"
  },
  "versions": [
    {
      "range": "18.4.0 - 18.6.1",
      "status": "verified",
      "verifiedThrough": "18.6.1",
      "verifiedOn": "2026-10-18"
    }
  ],
  "idle": {
    "frame": {
      "walk": "interior",
      "top": {
        "pattern": "^(?:╭─{2}.*|(?:\\u{E0B6} |\\s?)(?:π|\\u{F0D57}|[⠀-⣿]\\s+\\d+[smh])\\s.*(?:▶|\\u{E0B0})─.*|\\s?(?:\\u{E0B6} )?(?:(?![\\u{E0A0}-\\u{E0D7}])[\\p{Co}\\p{So}π]|pi|[⠀-⣿]\\s+\\d+[smh])\\s.*(?:─{3}|-{3}).*)$",
        "column": 0,
        "maxColumn": 1
      },
      "prompt": {
        "pattern": "^(?:╰─|│) {0,2}(?<draft>(?:(?!\\s{8,}\\S).)*?)(?:\\s{8,}\\S.*?)?(?:\\s*(?:│|█|─?╯))?$",
        "column": 0
      },
      "bottom": {
        "pattern": "^",
        "column": 0,
        "maxColumn": 3,
        "open": true
      },
      "rows": "^(?:(?:\\u{E0B6} |\\s?)(?:π|\\u{F0D57}|[⠀-⣿]\\s+\\d+[smh])\\s.*(?:▶|\\u{E0B0}).*|\\s?(?:\\u{E0B6} )?(?:(?![\\u{E0A0}-\\u{E0D7}])[\\p{Co}\\p{So}π]|pi|[⠀-⣿]\\s+\\d+[smh])\\s.*(?:─{3}|-{3}).*|╭─.*|╰─.*|│.*|\\s{3}.*|\\s*)$",
      "continuation": "^(?:│|╰─)? ?(?<text>.*?)(?:\\s*(?:│|█|─?╯))?$",
      "continuationIndent": 0,
      "maxDraftRows": 40,
      "maxTailRows": 3
    },
    "frameAlternates": [
      {
        "top": {
          "pattern": "^─+(?:\\s+(?<label>\\S.*?))?(?:\\s+─+)?$",
          "minCells": 8,
          "column": 0
        },
        "prompt": {
          "pattern": "^❯(?: (?<draft>(?:(?!\\s{8,}\\S).)*))?(?:\\s{8,}\\S.*)?$",
          "column": 0
        },
        "bottom": {
          "pattern": "^─+$",
          "minCells": 8,
          "column": 0
        },
        "continuationIndent": 2,
        "maxDraftRows": 40,
        "maxTailRows": 3
      },
      {
        "walk": "interior",
        "top": {
          "pattern": "^─+$",
          "minCells": 8,
          "column": 0
        },
        "prompt": {
          "pattern": "^(?<draft>(?:(?!\\s{8,}\\S).)*)(?:\\s{8,}\\S.*)?$",
          "column": 0,
          "maxColumn": 400
        },
        "bottom": {
          "pattern": "^─+$",
          "minCells": 8,
          "column": 0
        },
        "under": "^\\s*\\S.*·",
        "continuationIndent": 0,
        "maxDraftRows": 30,
        "maxTailRows": 3
      },
      {
        "walk": "interior",
        "top": {
          "pattern": "^─+(?:\\s+\\S.*)?$",
          "minCells": 8,
          "column": 0
        },
        "prompt": {
          "pattern": "^❯(?: (?<draft>(?:(?!\\s{8,}\\S).)*))?(?:\\s{8,}\\S.*)?$",
          "column": 0
        },
        "bottom": {
          "pattern": "^",
          "column": 0,
          "maxColumn": 3,
          "open": true
        },
        "rows": "^(?:─+.*|❯.*|\\s{2}.*|\\s*|\\s*\\S.*·.*)$",
        "trailer": {
          "row": "^\\s*\\S.*·.*$"
        },
        "continuation": "^\\s{0,2}(?<text>.*)$",
        "continuationIndent": 0,
        "maxDraftRows": 40,
        "maxTailRows": 3
      },
      {
        "top": {
          "pattern": "^$",
          "column": 0,
          "blank": true
        },
        "prompt": {
          "pattern": "^❯(?: (?<draft>(?:(?!\\s{8,}\\S).)*))?(?:\\s{8,}\\S.*)?$",
          "column": 0
        },
        "bottom": {
          "pattern": "^\\s?π · .*$",
          "column": 0,
          "maxColumn": 1
        },
        "continuationIndent": 2,
        "maxDraftRows": 40,
        "maxTailRows": 3
      }
    ],
    "placeholders": {
      "texts": [],
      "sgr": 2
    },
    "volatile": {
      "above": {
        "maxRows": 6
      },
      "below": {
        "maxRows": 2,
        "footerMaxRows": 2,
        "commandList": {
          "lead": "/",
          "sides": [
            "under"
          ],
          "pointer": "^(?:❯|\\u{F054}) (?:[^\\x00-\\x7F\\s]\\S* {1,2})?(?<command>\\w[\\w:.-]*)(?: {2,}\\S.*)?$",
          "entry": "^ {2}(?:[^\\x00-\\x7F\\s]\\S* {1,2})?(?<command>\\w[\\w:.-]*)(?: {2,}\\S.*)?$",
          "wrapped": "^ {8,}\\S",
          "namespaces": [
            "skill:"
          ],
          "argumentList": true
        }
      }
    },
    "runningRows": [
      "^\\s*[⠀-⣿] Working…",
      "^\\s*⎋ Working…",
      "^(?:\\u{E0B6} |\\s?)[⠀-⣿]\\s+\\d+[smh]\\s.*(?:▶|\\u{E0B0})",
      "^\\s?(?:\\u{E0B6} )?[⠀-⣿]\\s+\\d+[smh]\\s.*(?:─{3}|-{3})",
      "^╭─{2} [⠀-⣿] \\d+[smh] "
    ],
    "dialogsInBox": true,
    "inlineHint": {
      "fg": [
        "rgb(107,114,128)"
      ]
    }
  },
  "keys": {
    "submit": [
      "ctrl+q"
    ],
    "commandSubmit": [
      "Enter"
    ],
    "newline": [
      "ctrl+j"
    ],
    "interrupt": [
      "Escape"
    ],
    "clear": {
      "key": "Backspace",
      "slack": 16
    },
    "navigation": {
      "up": "Up",
      "down": "Down",
      "confirm": "Enter",
      "cancel": "Escape"
    },
    "enterWhileRunning": "steers",
    "queueKey": "ctrl+q",
    "commandsRunInTurn": [
      "/goal"
    ],
    "commandsRunInTurnNote": "Measured on OMP 18.12.2 through Herdr 0.9.5 with the probe, the text and Enter while a goal turn streamed. Lab 2026-10-19: /goal status, /goal pause, /goal resume and a bare /goal each ran at once and none became a steering row; a prompt-template command (/labnote) became a Steering row. Lab 2026-10-22 ran /goal pause, /goal resume and a bare /goal again and kept every screen the send reads (web/src/fixtures/panes/omp--v18-12-2-goal-*): OMP printed Goal mode paused. and Goal mode resumed., the status segment went from 🎯 Goal to ⏸ Goal and back, the turn kept running, and the bare /goal opened the goal menu. With /goal pause or /goal resume typed OMP draws the argument's own list under the box, the pointer on the argument typed; commandList.argumentList reads that list as the typed command's own.",
    "queuedRow": {
      "pattern": "^\\s*\\d+\\. (?<text>\\S.*?)\\s*$",
      "hint": "^\\s*└ Alt\\+↑ to edit\\s*$",
      "hintGap": 0
    }
  },
  "collapse": {
    "pattern": "(?:📄|🖼|\\u{F15C}|\\u{F03E}) #\\d+"
  },
  "reservedLeads": [
    "/",
    "!"
  ],
  "probe": {
    "char": "⌁",
    "status": "provisional",
    "note": "M56 spec 01 lab, 2026-10-15, omp: inert in every dialog without a text field on Herdr, tmux and zellij; the box shows it as `╰─ ⌁`; the /model picker takes Backspace, so a probe there fails safe; fallback ¤; live sends passed on omp 18.6.1 only, above the ledger range 18.4.0 to 18.4.10, so the probe stays on until a send passes inside it"
  },
  "paste": {
    "bracketed": true
  },
  "hooks": {}
}
