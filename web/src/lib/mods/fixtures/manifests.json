{
  "legs": {
    "id": "legs",
    "name": "Browser leg",
    "run": "./legs.sh",
    "every": "30s",
    "facts": 1,
    "icon": "flask",
    "places": ["belt", "session"]
  },
  "tracker": {
    "id": "tracker",
    "name": "Tracker",
    "run": "bun provider.ts",
    "every": "5m",
    "icon": "list",
    "places": ["session"]
  },
  "later": {
    "id": "watcher",
    "name": "Watcher",
    "run": "./watch.sh",
    "watch": ["~/.cache/collie-lab/leg.log"],
    "on": ["turn.end"],
    "mode": "serve",
    "places": ["belt", "dashboard"]
  }
}
