{
  "legs": {
    "id": "legs",
    "name": "Browser leg",
    "run": "./legs.sh",
    "every": "30s",
    "facts": 1,
    "icon": "flask",
    "places": [
      "belt",
      "session"
    ]
  },
  "tracker": {
    "id": "tracker",
    "name": "Tracker",
    "run": "bun program.ts",
    "every": "5m",
    "icon": "flag",
    "places": [
      "session",
      "tab"
    ]
  },
  "later": {
    "id": "watcher",
    "name": "Watcher",
    "run": "./watch.sh",
    "watch": [
      "~/.cache/collie-lab/leg.log"
    ],
    "on": [
      "turn.end"
    ],
    "mode": "serve",
    "places": [
      "belt",
      "dashboard"
    ]
  }
}
