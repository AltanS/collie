{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "plugins": [
    "typescript",
    "react",
    "import",
    "promise",
    "node",
    "unicorn",
    "oxc",
    "jsx-a11y"
  ],
  "ignorePatterns": [
    "node_modules/**",
    "web/node_modules/**",
    "web/dist/**",
    "web/dist-staging/**",
    "web/dev-dist/**",
    "bin/**",
    "contrib/**",
    "tools/oxlint/anti-slop/**",
    ".tracker/**",
    ".adr/**",
    ".claude/**",
    "assets/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ],
  "rules": {
    // ── Triage pass (M8 S3, 2026-08-18). Rationale table: .tracker/M8-lint-gate/03-pay-down-the-findings.md ──
    // Both tsconfigs set `"jsx": "react-jsx"` (automatic runtime) and web builds through @vitejs/plugin-react — a `React` import in scope is never required, and adding 1,427 of them would be dead code.
    "react/react-in-jsx-scope": "off",
    // Every non-test site is ordered-by-contract, never throughput-bound: pane choreography re-reads the terminal between keystrokes (web/src/lib/multi-select-action.ts, reply-action.ts, harness/guard.ts), journal adapters gate each candidate path through containedRealpath before the next (bridge/journal/*.ts), and pack/CLI loops serialise writes to one JSON store (cli/pack.ts commitPackChange). `Promise.all` here is a correctness regression — interleaved keys into one shared PTY — not an optimisation.
    "eslint/no-await-in-loop": "off",
    // Three unrenameable families: tooling-imposed globals (`__WB_MANIFEST` injected by vite-plugin-pwa, `__BUILD_INFO__` from Vite `define`), a `_x` backing field behind a same-named getter (bridge/push.ts `_enabled` / `get enabled()`), and the repo-wide `__resetX()` test-seam marker on module singletons where the dangle IS the "not public API" signal.
    "eslint/no-underscore-dangle": "off",
    // Every keyed list in this app is positional-by-nature: terminal grid rows, ANSI segments within a row, parsed dialog option rows (whose synthetic ids are literally `opt-${i}`), markdown inline pieces, transcript parts. Position IS the identity — there is no stable id, and content-derived keys would remount every changed row of the mirror's hottest path on each poll and break ansi-output's scroll anchor.
    "react/no-array-index-key": "off",
    // The remaining roles are deliberate: `role="img"` on inline <svg>/initials <span> (an <img> needs a src), checkbox/radio roles on buttons that MIRROR terminal state and must never own their own checked state, and sheet surfaces where native <dialog>/<fieldset> semantics (top-layer, light-dismiss, form implication) collide with the app's gesture handling and ADR 0007's pause-not-gate idle lock. The four convertible `role="status"` banners were converted to <output> before this exemption.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Side-effect imports have no assignable form: ./index.css, @testing-library/jest-dom/vitest, ./lib/pwa (SW registration). Same exemption ts-factory-stack records.
    "import/no-unassigned-import": "off",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  },
  "overrides": [
    {
      // Herdr socket + HTTP wire parsing: these modules ARE the I/O boundary the rule tells you to parse at, so `typeof` here is the parse, not a dodge of one. A schema validator instead of hand-rolled checks is a real future improvement but explicitly out of scope for M8. `mux/zellij/protocol.ts` joined the list in M10/05 for exactly the same role on the other multiplexer: it decodes `zellij action list-panes --json` and the `subscribe` stream — a third-party JSON format that drifts between zellij releases — and every `typeof` in it sits inside that file's own field readers.
      "files": [
        "**/bridge/mux/herdr/client.ts",
        "**/bridge/mux/zellij/protocol.ts",
        "**/bridge/dial.ts",
        "**/bridge/wire.ts",
        "**/bridge/types.ts",
        "**/bridge/config.ts",
        "**/bridge/uploads.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      // Journal adapters read third-party agent session logs off disk — untyped JSONL written by Claude/Codex/pi/opencode. `typeof` is how an unvalidated on-disk record is narrowed before it becomes a domain value.
      "files": [
        "**/bridge/journal/**/*.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      // Pack protocol handling (/pack/v1/*): payloads arrive from another Collie instance across a machine boundary and are untrusted until parsed. See PACK_PROTOCOL.md.
      "files": [
        "**/bridge/pack/**/*.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      // HTTP request bodies + disk-backed state: the same boundary class as the wire/journal/pack overrides above. Every `typeof` in these files sits inside the module's own coercion function — server.ts's `expectedPrompt`/`normalizeTabLabel`/`parsePairRequest`/`parseNotifyPrefsPatch`/`isPushSubscription`/`supersededEndpoint` over `await req.json()`, `coercePending`/`coerceRegistry`/`normalizeLabel` (pairing.json + client labels), `coerceStored` + `describeSendError` (subscription store + an untyped web-push rejection), `coerceNotifyPrefs`, `coerceActivityFile`, the `JSON.parse` reloads in snooze/version/update, `commands.toml` rows (ADR 0018), the same checks copied verbatim into `keys.toml`'s row validator (operator-keys.ts) and the shared TOML reader they both sit behind (operator-file.ts), and audit.ts's `sanitize()` walk of an arbitrary JSON value where `typeof` IS the dispatch. The only real fix is a schema validator, explicitly out of scope for M8.
      "files": [
        "**/bridge/server.ts",
        "**/bridge/pairing.ts",
        "**/bridge/push.ts",
        "**/bridge/notify-prefs.ts",
        "**/bridge/activity.ts",
        "**/bridge/operator-commands.ts",
        "**/bridge/operator-keys.ts",
        "**/bridge/operator-file.ts",
        "**/bridge/audit.ts",
        "**/bridge/snooze.ts",
        "**/bridge/version.ts",
        "**/bridge/update.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      // localStorage-backed preference stores: the browser's untyped string store is the phone's disk, and each file's `typeof` is either its own `coerce`/`load` parse of `JSON.parse(raw)` or the `typeof localStorage === "undefined"` probe these modules need to also evaluate under jsdom and in the service worker.
      "files": [
        "**/web/src/hooks/use-display-prefs.ts",
        "**/web/src/hooks/use-dash-prefs.ts",
        "**/web/src/hooks/use-theme.ts",
        "**/web/src/lib/drafts.ts",
        "**/web/src/lib/haptics.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      // A per-suite helper deliberately lives inside the `describe` it belongs to: hoisting 109 of them to module scope moves fixtures away from the test that owns them and lets one suite's helper leak into its neighbour. The rule's premise (reuse + per-call allocation) is a production concern; it stays at error in production code.
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      // web/ has no DI container by design (CLAUDE.md: components import hooks and `lib/api.ts` directly, no TanStack Query). The HTTP seam is already faked faithfully at the network with MSW — never with `vi.mock` — and the residual mocks stage hooks/timers whose only alternative is threading providers through production components for the test's benefit. Bridge/CLI tests inject real fakes and stay at error.
      "files": [
        "**/web/src/**/*.test.ts",
        "**/web/src/**/*.test.tsx"
      ],
      "rules": {
        "anti-slop/no-module-mocking": "off"
      }
    }
  ]
}
