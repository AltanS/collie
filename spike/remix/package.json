{
  "name": "collie-remix-spike",
  "private": true,
  "type": "module",
  "dependencies": {
    "@remix-run/ui": "0.12.1",
    "remix": "3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/bun": "^1.4.2",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "1.62.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.0"
  },
  "scripts": {
    "test:server": "bun test probe1-server",
    "serve": "bun probe1-server/server.ts",
    "build:client": "vite build --config probe2-client/vite.config.ts",
    "build:client:split": "SPLIT_VENDOR=1 vite build --config probe2-client/vite.config.ts",
    "build:react-baseline": "vite build --config probe2-client/react-baseline/vite.config.ts",
    "build:bench": "vite build --config probe3-screen/vite.config.ts",
    "bench": "bun probe3-screen/run.ts http://127.0.0.1:5194 chromium 10000",
    "nav": "bun probe4-nav/nav.ts http://127.0.0.1:5193 chromium,chromium-nonav",
    "table": "bun results/table.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:motion": "vite build --config probe5-motion/vite.config.ts",
    "preview:motion": "vite preview --config probe5-motion/vite.config.ts",
    "motion": "bun probe5-motion/run.ts http://127.0.0.1:5190 chromium"
  }
}
