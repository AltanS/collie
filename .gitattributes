# Captured fixtures are read raw (readFileSync) and compared byte for byte, so they stay byte-exact on
# every platform. A CRLF checkout puts `\r` on every row and the Surface tests (clear-all, protocol)
# fail. GitHub's windows.yml sets core.autocrlf=false before checkout; a contributor's own Windows
# checkout (Git for Windows defaults to autocrlf=true) does not, so the attribute carries it.

# TypeScript sources are text, always. multi-select-action.ts uses a NUL as a map-key separator, and
# a single such byte makes git classify the whole file as binary — which silently hid every change to
# the race guard from `git show` and from PR review. The byte is now a source escape, but this keeps
# any future one from costing reviewability.
*.ts diff
*.tsx diff

# A shell script is read by `sh`, which cannot take a CRLF line. A Windows checkout with autocrlf would
# turn the installer the CLI embeds (and `crew add` sends to a POSIX host) into one.
*.sh text eol=lf

# The vendored speech engine is pinned by hash (ADR 0096). A Windows checkout with autocrlf would
# rewrite the glue's line endings and the served bytes would no longer be the hashed bytes.
web/public/stt/** -text

# The skill texts the CLI embeds and writes into a harness. A CRLF checkout would put `\r` in the
# rendered skill. The code strips it as well (cli/docs-embed.ts), because an installed copy can be CRLF.
cli/skill.md text eol=lf
cli/skills/*.md text eol=lf

# Recorded model streams of the browser leg (M67): fixtures, never reviewed line by line.
web/e2e/rig/cassettes/**/*.jsonl linguist-generated=true

# Terminal screens, session logs and recorded tool output that tests read raw. The rule is per folder,
# never `* -text`: sources and docs keep normal handling.
web/src/fixtures/** -text
bridge/surface/fixtures/** -text
bridge/journal/fixtures/** -text
bridge/fixtures/** -text
bridge/mux/herdr/captures/** -text
bridge/mux/tern/captures/** -text
bridge/mux/durable/fixtures/** -text
