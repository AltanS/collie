// The Worker and its one Durable Object. `wrangler dev --port 8801 --ip 127.0.0.1` runs it locally;
// `wrangler deploy` puts it on your account. The token is a secret, never a var: `wrangler secret put
// COLLIE_TOKEN`, or `.dev.vars` for wrangler dev.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collie-durable-member",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // Pi Durable and Cloudflare's PiHarness (package `agents`) need Node's APIs.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "MEMBER", "class_name": "Member" }]
  },
  // A real model: Workers AI through this binding, no key in the Worker. It is off, because the binding is remote
  // even under wrangler dev: on, `wrangler dev` needs a Cloudflare account (README, "A real model"). Uncomment it
  // to use the model; every ticket is then billed by Cloudflare.
  // "ai": { "binding": "AI" },
  // The SQLite storage backend. PiHarness keeps Pi Durable's tables in ctx.storage.sql, under the prefix `pi_`.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Member"] }],
  // The Pi glue and the script are shared with ../../examples/durable-member and import Pi from there. These
  // lines make the bundle take Pi from THIS folder, so there is one copy of each package. Two copies
  // would break Pi's class checks. vitest.config.ts (dedupe) and tsconfig.json (paths) say the same.
  "alias": {
    "@earendil-works/pi-durable": "./node_modules/@earendil-works/pi-durable/dist/index.js",
    "@earendil-works/pi-ai": "./node_modules/@earendil-works/pi-ai/dist/index.js",
    "@earendil-works/pi-ai/providers/faux": "./node_modules/@earendil-works/pi-ai/dist/providers/faux.js",
    "@earendil-works/chord": "./node_modules/@earendil-works/chord/dist/index.js",
    "@earendil-works/chord/context": "./node_modules/@earendil-works/chord/dist/context/index.js"
  }
}
