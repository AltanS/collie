# Dependencies
node_modules
.pnp
.pnp.*

# Build output
dist/
build/
out/
target/
# The compiled `collie` binary — built from the checkout, never committed.
/bin/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & secrets
.env
.env.*
!.env.example

# Bun / Node
.bun/
bun.lockb

# Editor & OS
# `.vscode/*` (not `.vscode/`) so the two SHARED editor files below can be re-included: git cannot
# re-include a path whose parent DIRECTORY is excluded. Everything else in there stays personal.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Scratch / local
*.local
.cache/

# Agent / local tooling state. Same `/*`-plus-negation shape as .vscode above: the lint hook and its
# registration are a repo-wide enforcement surface and must travel with the checkout; agent-memory,
# worktrees and settings.local.json stay local.
.claude/*
!.claude/settings.json
!.claude/hooks/

# The tracker lives in the collie-workspace repo, never here
.tracker/

# Bug-repro screenshots — evidence for a fix, not documentation. Keep them local;
# the fix commit and its CHANGELOG line are the durable record.
.screenshot-bugs/
docs/bugs/

# Local tooling scratch (browser-automation captures)
.playwright-mcp/

# The browser tier's output: a screenshot and a trace kept only when a case fails, plus the HTML
# report over them. Evidence for whoever reads the failure, never a baseline — the CI job uploads
# these as an artefact and nothing compares them run to run.
web/test-results/
web/playwright-report/

# The service-worker tier's two bundles (M26/04). `web/e2e/.builds/a` and `.builds/b` are two real
# `vite build` runs, produced fresh whenever the swappable server starts, plus the one-line pointer
# that says which of them is being served. Build output, like `dist/` — never committed.
web/e2e/.builds/
