# Supply-chain cooldown, the same as collie's own .npmrc and bunfig.toml: a fresh resolution takes only versions
# that have been on the registry for 7 days. `npm ci` installs what package-lock.json pins and is not affected.
# npm reads this file from the install directory only, so this folder needs its own copy.
min-release-age=7
#
# Five packages are excluded. The maintainer waived the cooldown for them on 2026-10-13 (README, "Dependencies").
# agents 0.28.0: published 2026-10-09 by GitHub Actions, SLSA provenance naming cloudflare/agents,
# .github/workflows/release.yml on refs/heads/main at commit 48d9c36f, no install script of its own. The line can go
# after 2026-10-16 14:08 UTC.
# The four @earendil-works packages at 1.1.0: published 2026-10-07 by GitHub Actions, SLSA provenance naming
# refs/tags/v1.1.0 at commit abe508e1, no install scripts, no binaries. The lines can go after 2026-10-14 22:12 UTC.
min-release-age-exclude[]=agents
min-release-age-exclude[]=@earendil-works/pi-durable
min-release-age-exclude[]=@earendil-works/pi-ai
min-release-age-exclude[]=@earendil-works/chord
min-release-age-exclude[]=@earendil-works/pi-telemetry
