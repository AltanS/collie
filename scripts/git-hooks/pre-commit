#!/usr/bin/env bash
# Four independent guards. Install with: scripts/install-hooks.sh (sets core.hooksPath).
#
# A) Versioning guard — override with: SKIP_VERSION_CHECK=1 git commit …
#    1) versions must be consistent (check-version.sh)
#    2) if functional code changed and the canonical version did NOT move, the commit must add at
#       least one bullet under `## [Unreleased]` in CHANGELOG.md (the ordinary functional commit).
#       A staged CHANGELOG is also checked for SHAPE, whatever else the commit touches: every
#       bullet under `## [Unreleased]` sits below one of `### Added`, `### Changed`, `### Fixed`,
#       `### Packaging` or `### Docs`, and opens with a bold lead sentence. The page is built from those
#       leads (scripts/release-notes.ts), so a bullet without one is a bullet the page cannot
#       print. A `### ` heading is not a bullet and records nothing on its own.
#       Tests (`*.test.ts`, `*.test.tsx`, `*.test.sh`) and the hooks themselves
#       (`scripts/git-hooks/`) are not functional — they ship nothing, so a commit that only
#       touches them records nothing, exactly as a doc-only one does not.
#    3) if the canonical version DID move, it must move forward, and `## [Unreleased]` must be
#       empty — the release commit folds those lines under the new `## [x.y.z]` heading
#
# B) Lint guard — override with: SKIP_LINT_CHECK=1 git commit …
#    oxlint over the STAGED lintable files only. This is a convenience, not the authority: the
#    full-tree runs (CI and `collie build`) define "passing". Both shell out to the same
#    `.oxlintrc.json` at the repo root — no surface passes its own rule flags.
#
# C) Crew-wire guard — override with: SKIP_CREW_WIRE_CHECK=1 git commit …
#    A staged change to the crew wire surface must record a protocol decision (check-crew-wire.sh).
#
# D) flake.lock guard — override with: SKIP_FLAKE_LOCK_CHECK=1 git commit …
#    `flake.lock` pins the toolchain a published binary was built with, so it moves only in a
#    release commit — staged together with the three version files (check-flake-lock.sh). A first
#    arrival or a removal of the lock passes on its own; only a change needs the release commit.
#
# The four are skippable independently: SKIP_VERSION_CHECK=1 does not disarm the lint guard.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# The one staged-file list, shared by all three guards.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"

# ---- (A) versioning ---------------------------------------------------------------------------
if [ "${SKIP_VERSION_CHECK:-}" = "1" ]; then
  echo "pre-commit: SKIP_VERSION_CHECK=1 — skipping version guard" >&2
else
  # (1) consistency
  "$ROOT/scripts/check-version.sh" >/dev/null

  # Two kinds of file ship nothing, so neither is functional and neither is dropped from the
  # CHANGELOG for lack of care:
  #   - a test (`*.test.ts`, `*.test.tsx`, `*.test.sh`) — not in the binary, not in `web/dist`;
  #     the three suffixes are the whole convention, every test in the tree is named one of them
  #   - the git hooks themselves (`scripts/git-hooks/`) — they run on a developer's machine at
  #     commit time and are not in the release tarball at all
  # Neither is visible to an operator, so there is nothing for them to read a line about. A commit
  # that touches one of these AND the code under it still records: the source file survives this
  # filter, and the line is about the source.
  functional="$(echo "$staged" | grep -vE '(\.test\.(ts|tsx|sh)$|^scripts/git-hooks/)' || true)"

  # Bullets under `## [Unreleased]` in the CHANGELOG on stdin. The section runs from that heading
  # to the next `## ` heading. A `### Added` line starts with `#`, never `- `, so a group heading
  # is not a bullet and adding one records nothing on its own. Portable awk + grep only, this
  # hook also runs on macOS.
  unreleased_bullets() {
    awk '/^## \[Unreleased\]/{p=1;next} /^## /{p=0} p' \
      | grep -cE '^- ' || true
  }

  # The shape of those bullets. Since 1.6.0 the release page is BUILT from them
  # (`scripts/release-notes.ts`): it prints each bullet's bold lead under its group heading, so a
  # bullet with no lead, or one above every group heading, is a bullet the release page cannot
  # print. This says so at commit time rather than at tag time. Prints the offending line, or
  # nothing when the section is well shaped.
  unreleased_shape() {
    awk '
      /^## \[Unreleased\]/ { p = 1; group = 0; next }
      /^## /               { p = 0 }
      !p                   { next }
      /^### / {
        name = substr($0, 5)
        sub(/[ \t]+$/, "", name)
        if (name !~ /^(Added|Changed|Fixed|Packaging|Docs)$/) { print "bad-group\t" $0; next }
        group = 1
        next
      }
      /^- / {
        if (!group)                        { print "no-group\t" $0; next }
        if ($0 !~ /^- \*\*[^*]+\*\*/)  { print "no-lead\t" $0 }
      }
    '
  }

  # Shape, whenever the CHANGELOG is staged at all: a bullet the release page cannot print is
  # refused before the count below is even read, and the message names the shape rather than the
  # arithmetic. This runs for a doc-only commit too, because a malformed bullet reaches the release
  # either way.
  if echo "$staged" | grep -qx 'CHANGELOG.md'; then
    bad="$(git show :CHANGELOG.md | unreleased_shape || true)"
    if [ -n "$bad" ]; then
      {
        echo "✗ pre-commit: a bullet under \`## [Unreleased]\` is not shaped for the release page."
        echo "$bad" | while IFS="$(printf '\t')" read -r why line; do
          case "$why" in
            no-lead)   echo "  no bold lead:   $line" ;;
            no-group)  echo "  above a group:  $line" ;;
            bad-group) echo "  unknown group:  $line" ;;
          esac
        done
        echo
        echo "  Every bullet sits under one of \`### Added\`, \`### Changed\`, \`### Fixed\`,"
        echo "  \`### Packaging\`, \`### Docs\`, and opens with a bold lead sentence:"
        echo
        echo "    ### Fixed"
        echo
        echo "    - **The lead sentence, about ten words.** The detail follows here. (#147)"
        echo
        echo "  \`scripts/release-notes.ts\` prints that lead on the GitHub Release page."
        echo "  (Override once with SKIP_VERSION_CHECK=1 git commit.)"
      } >&2
      exit 1
    fi
  fi

  # (2)/(3) changelog-on-change — any functional path in this set must land a CHANGELOG line.
  if echo "$functional" | grep -qE '^(bridge/|cli/|web/src/|web/public/|web/vite\.config\.ts|web/index\.html|web/package\.json|scripts/|systemd/|package\.json|herdr-plugin\.toml)'; then
    read_ver() { sed -n 's/^[[:space:]]*version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' | head -1; }
    cur="$(read_ver < "$ROOT/herdr-plugin.toml")"
    prev="$(git show HEAD:herdr-plugin.toml 2>/dev/null | read_ver || true)"

    if [ -n "${prev:-}" ]; then
      if [ "$cur" = "$prev" ]; then
        # Ordinary functional commit: no bump, but the staged CHANGELOG must have grown a bullet
        # under `## [Unreleased]` compared with HEAD's.
        now=0; before=0
        if echo "$staged" | grep -qx 'CHANGELOG.md'; then
          now="$(git show :CHANGELOG.md | unreleased_bullets)"
          before="$(git show HEAD:CHANGELOG.md 2>/dev/null | unreleased_bullets)"
        fi
        if [ "$now" -le "$before" ]; then
          cat >&2 <<EOF
✗ pre-commit: functional code changed but nothing was recorded.
  Add one line under \`## [Unreleased]\` in CHANGELOG.md, in the same commit,
  below one of \`### Added\` / \`### Changed\` / \`### Fixed\` / \`### Packaging\` / \`### Docs\`,
  opening with a bold lead sentence (\`- **The lead sentence.** detail …\`); end with (#issue) where one
  exists, and no commit hash;
  or bump the version in herdr-plugin.toml, package.json and web/package.json for a release commit.
  (Doc-only and test-only changes need neither. Override once with SKIP_VERSION_CHECK=1 git commit.)
EOF
          exit 1
        fi
      else
        # Monotonicity: the new version must sort STRICTLY ABOVE the previous one — no downgrades or
        # typo'd versions. `sort -V` orders semver; the higher of {prev,cur} must be cur.
        higher="$(printf '%s\n%s\n' "$prev" "$cur" | sort -V | tail -1)"
        if [ "$higher" != "$cur" ]; then
          cat >&2 <<EOF
✗ pre-commit: version went backwards ($prev → $cur). The new version must be greater than the last.
EOF
          exit 1
        fi
        # Release commit: the Unreleased section must have been emptied into the new heading.
        left="$(git show :CHANGELOG.md | unreleased_bullets)"
        if [ "$left" -ne 0 ]; then
          cat >&2 <<EOF
✗ pre-commit: release commit but \`## [Unreleased]\` is not empty ($left line(s) left).
  Move its lines under the new \`## [x.y.z] - YYYY-MM-DD\` heading and leave an empty
  \`## [Unreleased]\` above it. (Override once with SKIP_VERSION_CHECK=1 git commit.)
EOF
          exit 1
        fi
      fi
    fi
  fi
fi

# ---- (C) crew wire ----------------------------------------------------------------------------
# The script owns the file list and the message; it reads the staged list we already computed.
STAGED_FILES="$staged" "$ROOT/scripts/check-crew-wire.sh" >/dev/null

# ---- (D) flake.lock ---------------------------------------------------------------------------
# Same shape as (C): the script owns the file list and the message, and reads the staged list we
# already computed.
STAGED_FILES="$staged" "$ROOT/scripts/check-flake-lock.sh" >/dev/null

# ---- (B) lint ---------------------------------------------------------------------------------
if [ "${SKIP_LINT_CHECK:-}" = "1" ]; then
  echo "pre-commit: SKIP_LINT_CHECK=1 — skipping lint guard" >&2
  exit 0
fi

# Lintable staged files, minus the vendored plugin sources (.oxlintrc.json ignores them too, but
# naming one explicitly on the command line would override that ignore).
lintable="$(echo "$staged" \
  | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' \
  | grep -vE '^(tools/oxlint/anti-slop/|contrib/)' || true)"

# Fast path: nothing lintable staged (doc-only commits, config-only commits) — don't spawn oxlint.
[ -z "$lintable" ] || {
  # Same config, same flags as `bun run lint`; only the file set narrows.
  if ! out="$(cd "$ROOT" && echo "$lintable" | xargs bun run --silent lint -- 2>&1)"; then
    {
      echo "✗ pre-commit: oxlint found issues in staged files."
      echo
      echo "$out"
      echo
      echo "  Fix the code — do not downgrade a rule or add a suppression comment."
      echo "  (Override once with SKIP_LINT_CHECK=1 git commit.)"
    } >&2
    exit 1
  fi
}

exit 0
