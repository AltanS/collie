{
  "name": "collie",
  "version": "1.0.0-alpha.2",
  "private": true,
  "license": "MIT",
  "description": "Collie — a mobile web UI to monitor and reply to your Herdr agent herd over Tailscale",
  "type": "module",
  "scripts": {
    "start": "bun run bridge/index.ts",
    "dev": "bun --watch bridge/index.ts",
    "build": "bun run cli/main.ts build",
    "build:web": "cd web && bun run build",
    "build:cli": "bun build --compile --target=bun ./cli/main.ts --outfile bin/collie",
    "web:dev": "cd web && bun run dev",
    "test": "bun test ./bridge ./cli && bash scripts/collie-ctl.test.sh && bash scripts/collie-cli.test.sh",
    "test:ctl": "bash scripts/collie-ctl.test.sh",
    "test:pack": "bun test ./bridge/pack/harness.test.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "web-push": "^3.6.7"
  }
}
