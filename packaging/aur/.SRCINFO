	source_aarch64 = collie-bin-1.7.0-aarch64.tar.gz::https://github.com/AltanS/collie/releases/download/v1.7.0/collie-1.7.0-linux-arm64.tar.gz
	sha256sums_aarch64 = 14965115892bbee67cbbfa3f7f706c356786482322e35f7626621a6401284444

