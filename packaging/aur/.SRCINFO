pkgbase = collie-bin
	pkgdesc = Phone web UI for the AI agents running in your terminal, served over Tailscale (official binary release)
	pkgver = 1.25.4
	pkgrel = 1
	url = https://github.com/AltanS/collie
	install = collie-bin.install
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = glibc
