pkgbase = collie-bin
	pkgdesc = Phone web UI for the AI agents running in your terminal, served over Tailscale (official binary release)
	pkgver = 1.22.3
	pkgrel = 1
	url = https://github.com/AltanS/collie
	install = collie-bin.install
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = glibc
	depends = bash
	optdepends = tailscale: publish the one managed front door with `collie serve` (the supported way to reach Collie from a phone)
	optdepends = herdr: read Herdr sessions from the phone — the multiplexer Omarchy ships, and one of the three Collie drives
	optdepends = tmux: mirror tmux sessions instead — one of the three multiplexers Collie drives, and Omarchy ships it too
	provides = collie
	conflicts = collie
	options = !strip
	options = !debug
