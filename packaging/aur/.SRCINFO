	source_aarch64 = collie-bin-1.25.1-aarch64.tar.gz::https://github.com/AltanS/collie/releases/download/v1.25.1/collie-1.25.1-linux-arm64.tar.gz
	sha256sums_aarch64 = 9685eee76604b89dfe5855ff4baff39b66f482d87262000c6defedfa195c78d4

